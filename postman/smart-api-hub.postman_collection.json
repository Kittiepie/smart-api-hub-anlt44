{
  "info": {
    "name": "Smart API Hub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Posts (example resource)",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?_page=1&_limit=10&_sort=created_at&_order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_limit", "value": "10" },
                { "key": "_sort", "value": "created_at" },
                { "key": "_order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "List posts with expand",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?_expand=user",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "_expand", "value": "user" }]
            }
          }
        },
        {
          "name": "Search posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?q=docker",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "q", "value": "docker" }]
            }
          }
        },
        {
          "name": "Get post by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/1", "host": ["{{baseUrl}}"], "path": ["posts", "1"] }
          }
        },
        {
          "name": "Create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('postId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New post\",\n  \"content\": \"Some content\",\n  \"user_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Replace post (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Replaced title\",\n  \"content\": \"Replaced content\",\n  \"user_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        },
        {
          "name": "Update post (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Patched title\"\n}" },
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        },
        {
          "name": "Delete post (admin only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        }
      ]
    }
  ]
}